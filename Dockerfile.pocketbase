# =============================================================================
# Dockerfile — PocketBase Backend
# =============================================================================
# Use a imagem oficial do PocketBase. A versão deve ser compatível com as
# migrations e hooks do projeto (testado com v0.36.x).
#
# Build: docker build -f Dockerfile.pocketbase -t cred10mix-pocketbase .
# -----------------------------------------------------------------------------

FROM alpine:latest AS builder

ARG PB_VERSION=0.36.0

RUN apk add --no-cache unzip ca-certificates

WORKDIR /pb

# Download do binário do PocketBase
RUN wget -q -O pb.zip "https://github.com/pocketbase/pocketbase/releases/download/v${PB_VERSION}/pocketbase_${PB_VERSION}_linux_amd64.zip" \
    && unzip pb.zip \
    && rm pb.zip

# -----------------------------------------------------------------------------
# Imagem final
# -----------------------------------------------------------------------------
FROM alpine:latest

RUN apk add --no-cache ca-certificates tzdata

WORKDIR /pb

COPY --from=builder /pb/pocketbase /pb/pocketbase
COPY pocketbase/migrations /pb/pb_migrations
COPY pocketbase/hooks /pb/pb_hooks

# Volume para dados persistentes (banco SQLite + uploads)
VOLUME /pb/pb_data

EXPOSE 8090

CMD ["/pb/pocketbase", "serve", "--http=0.0.0.0:8090"]
